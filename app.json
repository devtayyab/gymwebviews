{
  "expo": {
    "name": "Smarty Gym",
    "slug": "smarty-gym-webview",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/smarty-gym/icon/Icon_Padded.png",
    "scheme": "smartygym",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/smarty-gym/icon/Icon_Padded.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartygym.webview",
      "infoPlist": {
        "NSCameraUsageDescription": "Smarty Gym uses the camera to scan your membership QR code for gym check-in.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.smartygym.webview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/smarty-gym/icon/Icon_Padded.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Smarty Gym uses the camera to scan your membership QR code for gym check-in."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e112ac56-3367-4cec-82c5-1a7ca059e05c"
      }
    }
  }
}
