{
  "expo": {
    "name": "Smarty Gym",
    "slug": "smarty-gym-webview",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/smarty-gym/icon/Icon_Padded.png",
    "scheme": "smartygym",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/smarty-gym/icon/Icon_Padded.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smartygym.webview"
    },
    "android": {
      "package": "com.smartygym.webview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/smarty-gym/icon/Icon_Padded.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fef2f56f-8552-4554-b03f-41312c343eb3"
      }
    }
  }
}
